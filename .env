DATABASE_URL=file:/home/z/my-project/db/custom.db
# Cloud-Native Database Configuration
# Switch DB_PROVIDER to 'postgresql' to use PostgreSQL
DB_PROVIDER=sqlite
# PostgreSQL connection string (used when DB_PROVIDER=postgresql)
# Format: postgresql://user:password@host:5432/youngsend?schema=public&connection_limit=10&pool_timeout=30
DATABASE_POSTGRESQL_URL=postgresql://youngsend:youngsend@postgres:5432/youngsend?schema=public
# Cloud-Native Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=5
REDIS_KEY_PREFIX=ys
# Cloud-Native Kafka Configuration
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=youngsend-api
KAFKA_CONSUMER_GROUP=youngsend-workers
# Cloud-Native OpenSearch Configuration
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX_PREFIX=ys
# Cloud-Native OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=youngsend-api
OTEL_RESOURCE_ATTRIBUTES=service.version=0.2.1,deployment.environment=production
