# ═══════════════════════════════════════════════════════════
# Youngsend — Environment Configuration
# ═══════════════════════════════════════════════════════════

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://youngsend.space-z.ai
APP_URL=https://youngsend.space-z.ai

# ─── Stripe ─────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_MODE=true

# ─── Paystack ───────────────────────────────────────────────
# Get keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_TEST_MODE=true

# ─── IntaSend ───────────────────────────────────────────────
# Get keys from https://dashboard.intasend.com/settings/api-keys
INTASEND_PUBLIC_KEY=ISPubKey_live_6bc75fdc-9b11-4e79-8690-1c8200e45cd6
INTASEND_SECRET_KEY=
INTASEND_WEBHOOK_SECRET=
INTASEND_TEST_MODE=true

# ─── Flutterwave ────────────────────────────────────────────
# Get keys from https://dashboard.flutterwave.com/dashboards/settings/api-keys
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
FLW_TEST_MODE=true
