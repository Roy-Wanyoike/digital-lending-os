# =============================================================================
# Digital Lending OS - Environment Variables Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# NODE ENVIRONMENT
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Prisma/SQLite)
# -----------------------------------------------------------------------------
# SQLite: file:./dev.db or file:./custom.db
# PostgreSQL: postgresql://user:password@localhost:5432/dbname
# MySQL: mysql://user:password@localhost:3306/dbname
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------------------
# M-PESA / SAFARICOM DARAJA API INTEGRATION
# -----------------------------------------------------------------------------
# Get credentials from https://developer.safaricom.co.ke/

# Daraja App Credentials (from Safaricom Developer Portal)
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Lipa na M-Pesa Online (STK Push) Configuration
MPESA_PASSKEY=your_passkey_here
MPESA_SHORT_CODE=174379  # Your Paybill/Till number

# B2C (Disbursements) Configuration
MPESA_INITIATOR_PASSWORD=your_initiator_password_here
MPESA_SECURITY_CREDENTIAL=your_security_credential_here

# Environment: sandbox | production
MPESA_ENVIRONMENT=sandbox

# Callback URL Base (where Safaricom sends payment results)
# Must be publicly accessible HTTPS URL in production
MPESA_CALLBACK_URL=https://your-domain.com/api/payments

# -----------------------------------------------------------------------------
# JWT / AUTHENTICATION CONFIGURATION
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens - USE A STRONG RANDOM STRING IN PRODUCTION!
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_change_in_production

# Token expiration times (in milliseconds)
JWT_ACCESS_TOKEN_LIFETIME=1800000    # 30 minutes
JWT_REFRESH_TOKEN_LIFETIME=604800000 # 7 days

# Session cookie settings
SESSION_COOKIE_NAME=auth-token
SESSION_SECURE_COOKIE=true   # Set to true in production (HTTPS)
SESSION_DOMAIN=              # Optional: your domain for cross-subdomain cookies

# -----------------------------------------------------------------------------
# CREDIT REFERENCE BUREAU (CRB) INTEGRATION
# -----------------------------------------------------------------------------
# Metropol CRB, CreditInfo Kenya, TransUnion Kenya
CRB_PROVIDER=metropol        # metropol | creditinfo | transunion
CRB_API_KEY=your_crb_api_key
CRB_API_SECRET=your_crb_api_secret
CRB_ENVIRONMENT=test         # test | production

# -----------------------------------------------------------------------------
# KYC PROVIDER INTEGRATION
# -----------------------------------------------------------------------------
# Smile Identity, Onfido, or other KYC verification provider
KYC_PROVIDER=smile           # smile | onfido | internal
KYC_API_KEY=your_kyc_api_key
KYC_PARTNER_ID=your_partner_id
KYC_CALLBACK_URL=https://your-domain.com/api/kyc/callback

# -----------------------------------------------------------------------------
# SMS GATEWAY CONFIGURATION
# -----------------------------------------------------------------------------
# Africa's Talking, Twilio, or other SMS gateway
SMS_PROVIDER=africastalking   # africastalking | twilio | infobip

# Africa's Talking
AT_API_KEY=your_at_api_key
AT_USERNAME=your_at_username

# Twilio (alternative)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------------------------------------------------------
# EMAIL SERVICE CONFIGURATION
# -----------------------------------------------------------------------------
# SendGrid, Mailgun, AWS SES, etc.
EMAIL_PROVIDER=sendgrid       # sendgrid | mailgun | ses | smtp
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM_ADDRESS=noreply@your-domain.com
EMAIL_FROM_NAME=Digital Lending OS

# -----------------------------------------------------------------------------
# WEBHOOK CONFIGURATION
# -----------------------------------------------------------------------------
# Webhook signing secret for verifying incoming webhooks
WEBHOOK_SECRET=your_webhook_signing_secret

# -----------------------------------------------------------------------------
# REDIS / CACHE CONFIGURATION (Optional)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# NATS / MESSAGE QUEUE (Optional)
# -----------------------------------------------------------------------------
NATS_URL=nats://localhost:4222

# -----------------------------------------------------------------------------
# FILE STORAGE CONFIGURATION
# -----------------------------------------------------------------------------
# Local, S3, Azure Blob, Google Cloud Storage
STORAGE_PROVIDER=local        # local | s3 | azure | gcs

# AWS S3 (if using S3 storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
APP_NAME=Digital Lending OS
APP_URL=http://localhost:3000
APP_PORT=3000

# Super Admin account (for initial setup)
SUPER_ADMIN_EMAIL=admin@your-domain.com
SUPER_ADMIN_PASSWORD=change_this_immediately

# -----------------------------------------------------------------------------
# LOGGING & MONITORING
# -----------------------------------------------------------------------------
LOG_LEVEL=debug               # debug | info | warn | error
SENTRY_DSN=                   # Optional: Sentry error tracking DSN

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000   # 1 minute
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window

# =============================================================================
# END OF ENVIRONMENT VARIABLES
# =============================================================================
