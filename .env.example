# ─── Digital Lending OS (DLO) Environment Variables ────────────────────
# Multi-Tenant SaaS Platform for Kenyan Digital Credit Providers
# Copy this file to .env and fill in actual values.
#   cp .env.example .env
# Generate a NEXTAUTH_SECRET:  openssl rand -base64 32
# ──────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════
# REQUIRED
# ═══════════════════════════════════════════════════════════════════════

# Database connection URL (PostgreSQL / Supabase).
# Supabase Connection Pooling (port 6543) — for application queries.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Direct connection (port 5432) — for migrations (prisma migrate deploy).
# Required when using Supabase connection pooling.
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].supabase.com:5432/postgres

# Supabase Project URL and Keys
# SUPABASE_URL=https://[ref].supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required in production. Generate with: openssl rand -base64 32
# NEXTAUTH_SECRET=

# Public-facing URL of the application (used by NextAuth for callbacks)
NEXTAUTH_URL=http://localhost:3000

# Public URL exposed to client components
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════
# PAYMENT PROVIDERS
# ═══════════════════════════════════════════════════════════════════════
# Each provider falls back to demo mode when its keys are absent.
# Set TEST_MODE=true (or 1, yes, on) to use provider test/sandbox keys.

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_TEST_MODE=

# ── Paystack ──────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# PAYSTACK_TEST_MODE=

# ── Flutterwave ───────────────────────────────────────────────────────
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_WEBHOOK_SECRET=
# FLW_TEST_MODE=

# ── IntaSend ───────────────────────────────────────────────────────────
INTASEND_SECRET_KEY=
INTASEND_PUBLIC_KEY=
INTASEND_WEBHOOK_SECRET=
# INTASEND_TEST_MODE=

# ── Paya Ventures ─────────────────────────────────────────────────────
# Use PAYA_API_KEY (pre-issued bearer token) OR PAYA_EMAIL + PAYA_PASSWORD
# (rotating JWT obtained via POST /auth/login).
PAYA_API_KEY=
PAYA_EMAIL=
PAYA_PASSWORD=
PAYA_BASE_URL=https://getpaya.com/api/v1
PAYA_WEBHOOK_SECRET=
# PAYA_TEST_MODE=

# ═══════════════════════════════════════════════════════════════════════
# M-PESA / DARAJA (Safaricom)
# ═══════════════════════════════════════════════════════════════════════
# M-Pesa is the primary payment channel for Kenyan digital lending.
# Daraja API is Safaricom's developer portal for M-Pesa integration.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
# Environment: sandbox (testing) or live (production)
MPESA_ENVIRONMENT=sandbox
# M-Pesa B2C security credential (used for business-to-customer payouts)
# MPESA_B2C_SECURITY_CREDENTIAL=
# M-Pesa C2B validation/confirmation callback URLs (set automatically in live)
# MPESA_C2B_VALIDATION_URL=
# MPESA_C2B_CONFIRMATION_URL=

# ═══════════════════════════════════════════════════════════════════════
# KENYA-SPECIFIC CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════

# Credit Reference Bureau (CRB) API — for mandatory credit checks
CRB_API_KEY=
CRB_API_URL=

# Default currency for the platform (KES = Kenyan Shilling)
KES_DEFAULT_CURRENCY=KES

# Central Bank of Kenya (CBK) regulation enforcement
# When enabled, enforces: interest rate caps, cooling-off periods,
# total cost of credit disclosure, DCP license validation
CBK_REGULATION_ENABLED=true

# Default country code for new tenant onboarding
DEFAULT_COUNTRY=KE

# ═══════════════════════════════════════════════════════════════════════
# DATABASE (PostgreSQL / Supabase)
# ═══════════════════════════════════════════════════════════════════════
# DATABASE_URL and DIRECT_URL are set above in the REQUIRED section.
# DATABASE_URL uses Supabase's connection pooler (port 6543) for app queries.
# DIRECT_URL uses the direct connection (port 5432) for schema migrations.

# ═══════════════════════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════════════════════
# Required for Redis-based rate limiting, pub/sub, and caching.
# REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════════════════════
# KAFKA
# ═══════════════════════════════════════════════════════════════════════
# Comma-separated list of broker addresses for event streaming.
# KAFKA_BROKERS=localhost:9092

# ═══════════════════════════════════════════════════════════════════════
# OPENSEARCH
# ═══════════════════════════════════════════════════════════════════════
# Used for full-text search. Falls back to ELASTICSEARCH_URL if set.
# OPENSEARCH_URL=https://localhost:9200
# OPENSEARCH_USERNAME=admin
# OPENSEARCH_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════
# TEMPORAL
# ═══════════════════════════════════════════════════════════════════════
# Temporal workflow engine address for durable execution.
# TEMPORAL_ADDRESS=localhost:7233

# ═══════════════════════════════════════════════════════════════════════
# AUTH
# ═══════════════════════════════════════════════════════════════════════
# NEXTAUTH_SECRET and NEXTAUTH_URL are set above in the REQUIRED section.

# ═══════════════════════════════════════════════════════════════════════
# OBSERVABILITY (OTEL)
# ═══════════════════════════════════════════════════════════════════════
# OpenTelemetry service name and OTLP exporter endpoint for logs/traces.
# OTEL_SERVICE_NAME=dlo-api
# OTEL_EXPORTER_OTLP_ENDPOINT_LOGS=http://localhost:4318/v1/logs

# ═══════════════════════════════════════════════════════════════════════
# REALTIME / SOCKET
# ═══════════════════════════════════════════════════════════════════════
# WebSocket server URL for real-time features.
# SOCKET_URL=
