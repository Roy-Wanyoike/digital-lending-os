# ─── Youngsend Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in actual values.
#   cp .env.example .env
# Generate a NEXTAUTH_SECRET:  openssl rand -base64 32
# ──────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════
# REQUIRED
# ═══════════════════════════════════════════════════════════════════════

# Database connection URL. SQLite (default for local dev):
DATABASE_URL=file:/home/z/my-project/db/custom.db
# PostgreSQL example:
# DATABASE_URL=postgresql://youngsend:your-password@localhost:5432/youngsend

# Required in production. Generate with: openssl rand -base64 32
# NEXTAUTH_SECRET=

# Public-facing URL of the application (used by NextAuth for callbacks)
NEXTAUTH_URL=http://localhost:3000

# Public URL exposed to client components
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════
# PAYMENT PROVIDERS
# ═══════════════════════════════════════════════════════════════════════
# Each provider falls back to demo mode when its keys are absent.
# Set TEST_MODE=true (or 1, yes, on) to use provider test/sandbox keys.

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_TEST_MODE=

# ── Paystack ──────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# PAYSTACK_TEST_MODE=

# ── Flutterwave ───────────────────────────────────────────────────────
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_WEBHOOK_SECRET=
# FLW_TEST_MODE=

# ── IntaSend ───────────────────────────────────────────────────────────
INTASEND_SECRET_KEY=
INTASEND_PUBLIC_KEY=
INTASEND_WEBHOOK_SECRET=
# INTASEND_TEST_MODE=

# ── Paya Ventures ─────────────────────────────────────────────────────
# Use PAYA_API_KEY (pre-issued bearer token) OR PAYA_EMAIL + PAYA_PASSWORD
# (rotating JWT obtained via POST /auth/login).
PAYA_API_KEY=
PAYA_EMAIL=
PAYA_PASSWORD=
PAYA_BASE_URL=https://getpaya.com/api/v1
PAYA_WEBHOOK_SECRET=
# PAYA_TEST_MODE=

# ═══════════════════════════════════════════════════════════════════════
# DATABASE (PostgreSQL / SQLite)
# ═══════════════════════════════════════════════════════════════════════
# DATABASE_URL is set above in the REQUIRED section.
# SQLite uses file: URLs; PostgreSQL uses standard connection strings.

# ═══════════════════════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════════════════════
# Required for Redis-based rate limiting, pub/sub, and caching.
# REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════════════════════
# KAFKA
# ═══════════════════════════════════════════════════════════════════════
# Comma-separated list of broker addresses for event streaming.
# KAFKA_BROKERS=localhost:9092

# ═══════════════════════════════════════════════════════════════════════
# OPENSEARCH
# ═══════════════════════════════════════════════════════════════════════
# Used for full-text search. Falls back to ELASTICSEARCH_URL if set.
# OPENSEARCH_URL=https://localhost:9200
# OPENSEARCH_USERNAME=admin
# OPENSEARCH_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════
# TEMPORAL
# ═══════════════════════════════════════════════════════════════════════
# Temporal workflow engine address for durable execution.
# TEMPORAL_ADDRESS=localhost:7233

# ═══════════════════════════════════════════════════════════════════════
# AUTH
# ═══════════════════════════════════════════════════════════════════════
# NEXTAUTH_SECRET and NEXTAUTH_URL are set above in the REQUIRED section.

# ═══════════════════════════════════════════════════════════════════════
# OBSERVABILITY (OTEL)
# ═══════════════════════════════════════════════════════════════════════
# OpenTelemetry service name and OTLP exporter endpoint for logs/traces.
# OTEL_SERVICE_NAME=youngsend-api
# OTEL_EXPORTER_OTLP_ENDPOINT_LOGS=http://localhost:4318/v1/logs

# ═══════════════════════════════════════════════════════════════════════
# REALTIME / SOCKET
# ═══════════════════════════════════════════════════════════════════════
# WebSocket server URL for real-time features.
# SOCKET_URL=
