# =============================================================================
# Digital Lending OS - Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_VERSION=1
BASE_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL via Prisma)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/digital_lending_os?schema=public"
DB_POOL_SIZE=10

# -----------------------------------------------------------------------------
# AUTHENTICATION & JWT
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production-min-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000

# -----------------------------------------------------------------------------
# COOKIE SECURITY
# -----------------------------------------------------------------------------
COOKIE_SECRET=your-cookie-secret-change-in-production-min-32-chars

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# M-PESA DARAJA API (Safaricom)
# -----------------------------------------------------------------------------
MPESA_CONSUMER_KEY=your-consumer-key-here
MPESA_CONSUMER_SECRET=your-consumer-secret-here
MPESA_PASSKEY=your-passkey-here
MPESA_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox  # sandbox or production
MPESA_API_URL=https://sandbox.safaricom.co.ke

# Callback URLs (must be publicly accessible)
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/webhooks/mpesa/stkpush
MPESA_CONFIRMATION_URL=https://your-domain.com/api/v1/webhooks/mpesa/c2b/confirmation
MPESA_VALIDATION_URL=https://your-domain.com/api/v1/webhooks/mpesa/c2b/validation
MPESA_TIMEOUT_URL=https://your-domain.com/api/v1/webhooks/mpesa/timeout
MPESA_RESULT_URL=https://your-domain.com/api/v1/webhooks/mpesa/b2c/result

# B2C Disbursement
MPESA_B2C_SHORTCODE=600000
MPESA_B2C_SECURITY_CREDENTIAL=your-b2c-security-credential

# -----------------------------------------------------------------------------
# CRB (Credit Reference Bureau) INTEGRATION
# -----------------------------------------------------------------------------

# Metropol CRB
CRB_METROPOL_API_KEY=your-metropol-api-key
CRB_METROPOL_USERNAME=your-metropolis-username
CRB_METROPOL_PASSWORD=your-metropolis-password
CRB_METROPOL_URL=https://api.metropolcorp.com/v2

# TransUnion CRB
CRB_TRANSUNION_API_KEY=your-transunion-api-key
CRB_TRANSUNION_URL=https://api.transunion.co.ke

# CreditInfo CRB
CRB_CREDITINFO_API_KEY=your-creditinfo-api-key
CRB_CREDITINFO_URL=https://www.creditinfo.co.ke/api

# -----------------------------------------------------------------------------
# SMS GATEWAY
# -----------------------------------------------------------------------------
SMS_PROVIDER=africastalking  # africastalking, twilio, infobip
SMS_API_KEY=your-sms-api-key
SMS_USERNAME=your-sms-username
SMS_FROM_NAME=DLOS

# Africa's Talking specific
AT_API_KEY=your-africas-talking-api-key
AT_USERNAME=your-africas-talking-username
AT_SHORT_CODE=

# Twilio specific
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+254700000000

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=smtp  # smtp, sendgrid, ses

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@digitallendingos.com
EMAIL_FROM_NAME=Digital Lending OS

# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key

# AWS SES
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=your-aws-access-key-id
SES_SECRET_ACCESS_KEY=your-aws-secret-access-key

# -----------------------------------------------------------------------------
# FILE UPLOADS
# -----------------------------------------------------------------------------
UPLOAD_MAX_SIZE=5242880  # 5MB in bytes
UPLOAD_DIR=./uploads

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json  # json or simple
LOG_FILE=logs/app.log

# -----------------------------------------------------------------------------
# AUDIT LOGGING
# -----------------------------------------------------------------------------
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=90
AUDIT_LOG_SUCCESSFUL_AUTH=false
AUDIT_LOG_FAILED_AUTH=true

# -----------------------------------------------------------------------------
# WEBHOOK SECURITY
# -----------------------------------------------------------------------------
WEBHOOK_SECRET=your-webhook-signing-secret-change-in-production
WEBHOOK_TIMEOUT_MS=30000
WEBHOOK_RETRY_ATTEMPTS=3

# -----------------------------------------------------------------------------
# LOAN DEFAULTS
# -----------------------------------------------------------------------------
LOAN_MIN_AMOUNT=500
LOAN_MAX_AMOUNT=150000
LOAN_MIN_TERM_DAYS=7
LOAN_MAX_TERM_DAYS=180
LOAN_DEFAULT_INTEREST_RATE=15
LOAN_MAX_INTEREST_RATE=30
LOAN_GRACE_PERIOD_DAYS=3
LATE_FEE_PERCENTAGE=5
PENALTY_RATE_DAILY=1
