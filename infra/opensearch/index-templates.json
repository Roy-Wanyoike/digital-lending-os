{
  "index_templates": [
    {
      "name": "youngsend-payments-template",
      "index_patterns": ["payments*"],
      "template": {
        "settings": {
          "number_of_shards": 3,
          "number_of_replicas": 1,
          "refresh_interval": "5s",
          "index": {
            "max_result_window": 10000,
            "routing": {
              "allocation": {
                "enable": "all"
              }
            }
          },
          "analysis": {
            "analyzer": {
              "name_analyzer": {
                "type": "custom",
                "tokenizer": "standard",
                "filter": ["lowercase", "edge_ngram_filter"]
              },
              "email_analyzer": {
                "type": "custom",
                "tokenizer": "standard",
                "filter": ["lowercase", "email_normalizer"]
              },
              "autocomplete_analyzer": {
                "type": "custom",
                "tokenizer": "standard",
                "filter": ["lowercase", "shingle_filter"]
              }
            },
            "filter": {
              "edge_ngram_filter": {
                "type": "edge_ngram",
                "min_gram": 2,
                "max_gram": 20
              },
              "email_normalizer": {
                "type": "pattern_capture",
                "patterns": ["([^@]+)", "(\\w+)", "([^.]+)"],
                "preserve_original": true
              },
              "shingle_filter": {
                "type": "shingle",
                "min_shingle_size": 2,
                "max_shingle_size": 3
              }
            }
          }
        },
        "mappings": {
          "dynamic": "strict",
          "properties": {
            "amount": { "type": "double" },
            "currency": {
              "type": "text",
              "fields": { "keyword": { "type": "keyword" } }
            },
            "status": { "type": "keyword" },
            "provider": {
              "type": "text",
              "fields": { "keyword": { "type": "keyword" } }
            },
            "description": {
              "type": "text",
              "analyzer": "standard",
              "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } }
            },
            "createdAt": { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
            "updatedAt": { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
            "userId": { "type": "keyword" },
            "tenantId": { "type": "keyword" },
            "fromBusinessName": {
              "type": "text",
              "analyzer": "name_analyzer",
              "fields": { "keyword": { "type": "keyword" } }
            },
            "toBusinessName": {
              "type": "text",
              "analyzer": "name_analyzer",
              "fields": { "keyword": { "type": "keyword" } }
            },
            "paymentMethod": { "type": "keyword" },
            "escrowId": { "type": "keyword" },
            "intentRef": { "type": "keyword" },
            "txRef": { "type": "keyword" },
            "sourceAmount": { "type": "double" },
            "sourceCurrency": { "type": "keyword" },
            "targetAmount": { "type": "double" },
            "targetCurrency": { "type": "keyword" }
          },
          "dynamic_templates": [
            {
              "string_fields": {
                "match_mapping_type": "string",
                "mapping": {
                  "type": "text",
                  "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } }
                }
              }
            },
            {
              "metadata_fields": {
                "match": "metadata.*",
                "mapping": {
                  "type": "text",
                  "fields": { "keyword": { "type": "keyword" } },
                  "index": false
                }
              }
            }
          ]
        }
      },
      "priority": 200,
      "composed_of": []
    },
