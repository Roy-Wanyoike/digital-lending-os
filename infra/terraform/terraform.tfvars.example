# ─────────────────────────────────────────────────────────────────
# Digital Lending OS Terraform Variables
# Copy this file to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars to version control.
# ─────────────────────────────────────────────────────────────────

project_id  = "dlo-prod"
region      = "africa-south1"
zone        = "africa-south1-b"
environment = "prod"

zones       = ["africa-south1-b", "africa-south1-c", "africa-south1-d"]
cluster_name = "dlo-prod"

# ── Node pool defaults ──────────────────────────────────────────
node_count   = 3
machine_type = "e2-highcpu-4"

# ── GKE node service account (pre-created or let TF create) ─────
node_service_account = "dlo-gke-nodes@dlo-prod.iam.gserviceaccount.com"

# ── Database ─────────────────────────────────────────────────────
db_name      = "digital_lending_os"
db_user      = "digital_lending_os"
db_password  = "CHANGE_ME_USE_SECRET_MANAGER"
db_tier      = "db-custom-4-16384"
db_disk_size = 100

# ── Redis ────────────────────────────────────────────────────────
redis_memory_size_gb  = 5
redis_failover_region = "africa-south1"

# ── Networking (defaults usually fine) ───────────────────────────
# subnet_cidr   = "10.0.0.0/20"
# pods_cidr     = "10.4.0.0/14"
# services_cidr = "10.8.0.0/20"

# ── Authorized CIDRs for GKE master (e.g. your office IP) ───────
# authorized_networks = [
#   {
#     cidr_block   = "203.0.113.0/24"
#     display_name = "office"
#   },
# ]
