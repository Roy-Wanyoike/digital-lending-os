# =============================================================================
# Digital Lending OS - Comprehensive .gitignore
# =============================================================================
# Security-focused gitignore for GitHub/Production deployment
# Covers: Next.js, Prisma, TypeScript, Node.js, Docker, OS files, Secrets
# Last Updated: 2026-08-28
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT VARIABLES (CRITICAL - NEVER COMMIT THESE!)
# -----------------------------------------------------------------------------
.env
.env.local
.env.production
.env.development
.env.test
.env.staging
.env.*.local
!.env.example

# -----------------------------------------------------------------------------
# DEPENDENCIES (installed via npm/pnpm/yarn)
# -----------------------------------------------------------------------------
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Optional: Keep lockfiles for reproducible builds (uncomment if needed)
# package-lock.json
# yarn.lock
# bun.lock
.pnpm-store/

# -----------------------------------------------------------------------------
# BUILD OUTPUTS & COMPILATION ARTIFACTS
# -----------------------------------------------------------------------------
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts
.turbo/
.vercel/

# -----------------------------------------------------------------------------
# DATABASE FILES (contain sensitive data - NEVER COMMIT!)
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
prisma/*.db
prisma/*.sqlite
db/
data/
*.sql
*.dump
*.backup
*.bak
!prisma/migrations/
!prisma/schema.prisma

# -----------------------------------------------------------------------------
# LOGS & DEBUG FILES
# -----------------------------------------------------------------------------
logs/
*.log
dev.log
dev.out.log
server.log
error.log
access.log
npm-debug.log*
yarn-debug.log*
lerna-debug.log*
*.log.json

# -----------------------------------------------------------------------------
# CACHE & TEMPORARY FILES
# -----------------------------------------------------------------------------
.cache/
temp/
tmp/
*.tmp
*.temp
.parcel-cache/
.eslintcache
.stylelintcache
*.cache
TurboRoot*
.swc-cache/

# -----------------------------------------------------------------------------
# IDE & EDITOR CONFIGURATIONS (user-specific)
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project
.code-workspace
.history/
*.code-workspace

# VS Code - keep settings but ignore workspace state
.vscode/tasks.json
.vscode/launch.json
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/recommended.extensions.json

# -----------------------------------------------------------------------------
# OPERATING SYSTEM FILES
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.lnk
*.ini

# macOS
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# SECURITY SENSITIVE FILES (SECRETS, KEYS, CREDENTIALS)
# -----------------------------------------------------------------------------
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
credentials.json
service-account.json
gcloud-service-key.json
aws-credentials.json
secrets.yaml
secrets.yml
.secrets/
*.secret
*.ppk
*.jks
*.keystore
*.p8
*.mobileprovision

# M-Pesa / Payment credentials
mpesa-certificates/
certificates/
*.pk8
*.der

# OAuth tokens
oauth_tokens.json
token.json
access_token.json

# -----------------------------------------------------------------------------
# COVERAGE & TESTING ARTIFACTS
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
.jest/
test-results/
playwright-report/
test-results/
junit.xml
lcov.info
coverage.lcov
*.coveragerc
.pytest_cache/
.mypy_cache/

# -----------------------------------------------------------------------------
# DEPLOYMENT & PLATFORM CONFIGURATIONS
# -----------------------------------------------------------------------------
.vercel/
.netlify/
.serverless/
.firebase/
.amplify/
Railway/
Render/
.now/
.deno/

# -----------------------------------------------------------------------------
# DOCKER
# -----------------------------------------------------------------------------
docker-compose.override.yml
.docker/local.env
docker-compose.yml.override
.docker/

# -----------------------------------------------------------------------------
# MISCELLANEOUS - PROJECT SPECIFIC
# -----------------------------------------------------------------------------
local-*
*.bak
*.backup
*.dump
*.sql.gz
.claude
.z-ai-config
tool-results/
agent-ctx/
.zscripts/
mini-services/
skills/
examples/
download/
prompt
test
worklog.md

# Agent-specific files
agent-ctx/

# Screenshots (generated during development)
*.png
!public/**/*.png
!src/**/*.png
!docs/**/*.png

# Generated documentation (auto-generated)
docs/AUTOGENERATED*

# -----------------------------------------------------------------------------
# NEXT.JS SPECIFIC
# -----------------------------------------------------------------------------
next-env.d.ts

# -----------------------------------------------------------------------------
# PRISMA SPECIFIC
# -----------------------------------------------------------------------------
prisma/*.db
prisma/*.sqlite
prisma/*.db-journal
prisma/*.db-wal

# -----------------------------------------------------------------------------
# TYPESCRIPT / JAVASCRIPT
# -----------------------------------------------------------------------------
*.tsbuildinfo
*.map
lib-cov
node_modules/.cache
*.pid
*.seed
*.pid.lock
.coverage
.grunt
.lock-wscript
build/Release
*.tgz
.yarn-integrity
.webpack-cache
.eslintcache

# -----------------------------------------------------------------------------
# MISCELLANEOUS DEVELOPMENT FILES
# -----------------------------------------------------------------------------
.sass-cache
bower_components
.grunt
.lock-wscript
lib-cov
build/Release

# Archive files (keep source, ignore compressed)
*.tar.gz
*.zip
*.rar
*.7z
!digital-lending-os.zip  # Keep our distribution zip visible locally

# Backup files
*#
*~*
*.orig
*.merge

# Lock files for various tools
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockfile

# -----------------------------------------------------------------------------
# PYTHON (if using Python scripts for data processing)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
mypy_cache/
.dmypy.json
dmypy.json
pyenv.cfg

# -----------------------------------------------------------------------------
# ADDITIONAL SECURITY PATTERNS
# -----------------------------------------------------------------------------
# Environment variable injection attempts
.env.production.local
.env.development.local
.env.test.local

# Sensitive config files
config/local.json
config/production.json
config/secrets.json
credentials/
keys/
ssl/
certs/

# Session/Cookie stores
sessions/
cookies/
*.session

# -----------------------------------------------------------------------------
# CI/CD SPECIFIC
# -----------------------------------------------------------------------------
.github/workflows/*.local.yml
.gitlab-ci.local.yml
circleci.local.yml
codeship.local.yml

# -----------------------------------------------------------------------------
# DOCUMENTATION GENERATED FILES
# -----------------------------------------------------------------------------
docs/generated/
docs/api-reference/
*.generated.md
CHANGELOG.md.auto

# -----------------------------------------------------------------------------
# PERFORMANCE & PROFILING
# -----------------------------------------------------------------------------
.cpuprofile
*.prof
.profile
heapdump.*
core
core.*

# -----------------------------------------------------------------------------
# MISC
# -----------------------------------------------------------------------------
.DS_Store
*.pid
*.seed
*.pid.lock
