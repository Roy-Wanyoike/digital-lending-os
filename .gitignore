# =============================================================================
# Digital Lending OS - Comprehensive .gitignore
# =============================================================================
# Security-focused gitignore for GitHub/Production deployment
# Last Updated: 2026-08-28
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT VARIABLES (CRITICAL - NEVER COMMIT THESE!)
# -----------------------------------------------------------------------------
.env
.env.local
.env.production
.env.development
.env.test
.env.staging
.env.*.local
!.env.example

# -----------------------------------------------------------------------------
# DEPENDENCIES (installed via npm/pnpm/yarn)
# -----------------------------------------------------------------------------
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
bun.lock
.pnpm-store/

# -----------------------------------------------------------------------------
# BUILD OUTPUTS & COMPILATION ARTIFACTS
# -----------------------------------------------------------------------------
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts
.turbo/

# -----------------------------------------------------------------------------
# DATABASE FILES (contain sensitive data)
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
prisma/*.db
prisma/*.sqlite
db/
!prisma/migrations/

# -----------------------------------------------------------------------------
# LOGS & DEBUG FILES
# -----------------------------------------------------------------------------
logs/
*.log
dev.log
dev.out.log
server.log
npm-debug.log*
yarn-debug.log*
lerna-debug.log*
*.log.json

# -----------------------------------------------------------------------------
# CACHE & TEMPORARY FILES
# -----------------------------------------------------------------------------
.cache/
temp/
tmp/
*.tmp
*.temp
.parcel-cache/
.eslintcache
.stylelintcache
*.cache
TurboRoot*

# -----------------------------------------------------------------------------
# IDE & EDITOR CONFIGURATIONS (user-specific)
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project
.code-workspace
.history/

# -----------------------------------------------------------------------------
# OPERATING SYSTEM FILES
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.lnk

# -----------------------------------------------------------------------------
# SECURITY SENSITIVE FILES (SECRETS, KEYS, CREDENTIALS)
# -----------------------------------------------------------------------------
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
credentials.json
service-account.json
gcloud-service-key.json
aws-credentials.json
secrets.yaml
secrets.yml
.secrets/
*.secret
*.ppk

# M-Pesa / Payment credentials
mpesa-certificates/
certificates/
*.pk8

# -----------------------------------------------------------------------------
# COVERAGE & TESTING ARTIFACTS
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
.jest/
test-results/
playwright-report/
test-results/
junit.xml

# -----------------------------------------------------------------------------
# DEPLOYMENT & PLATFORM CONFIGURATIONS
# -----------------------------------------------------------------------------
.vercel/
.netlify/
.serverless/
.firebase/
.amplify/
 Railway/
Render/

# -----------------------------------------------------------------------------
# DOCKER
# -----------------------------------------------------------------------------
docker-compose.override.yml
.docker/local.env
docker-compose.yml.override

# -----------------------------------------------------------------------------
# MISCELLANEOUS - PROJECT SPECIFIC
# -----------------------------------------------------------------------------
local-*
*.bak
*.backup
*.dump
*.sql.gz
.claude
.z-ai-config
tool-results/
agent-ctx/
.zscripts/
mini-services/
skills/
examples/
download/
prompt
test

# Agent-specific files
agent-ctx/
worklog.md

# Screenshots (generated during development)
*.png
!public/**/*.png
!src/**/*.png

# Generated documentation (auto-generated)
docs/AUTOGENERATED*

# -----------------------------------------------------------------------------
# NEXT.JS SPECIFIC
# -----------------------------------------------------------------------------
next-env.d.ts

# -----------------------------------------------------------------------------
# PRISMA SPECIFIC
# -----------------------------------------------------------------------------
prisma/*.db
prisma/*.sqlite
prisma/*.db-journal
prisma/*.db-wal

# -----------------------------------------------------------------------------
# MISCELLANEOUS DEVELOPMENT FILES
# -----------------------------------------------------------------------------
*.map (source maps - optional to ignore)
.sass-cache
bower_components
.grunt
.lock-wscript
lib-cov
node_modules/.cache
*.pid
*.seed
*.pid.lock
.coverage
.nyc_output
.grunt
.lock-wscript
lib-cov
build/Release
*.tgz
.yarn-integrity
.webpack-cache
