    "html": "<html lang=\"en\" class=\"\"><head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Paya — Stablecoin payments for freelancers</title>\n  <meta name=\"description\" content=\"Get paid in USDC on Solana. Instant settlement, low fees, payment links and invoices for freelancers and small businesses worldwide.\">\n  <meta property=\"og:title\" content=\"Paya — Stablecoin payments for freelancers\">\n  <meta property=\"og:description\" content=\"Get paid in USDC on Solana. Instant settlement, low fees, payment links and invoices.\">\n  <meta property=\"og:type\" content=\"website\">\n  <meta property=\"og:url\" content=\"https://paya.fund\">\n  <meta name=\"theme-color\" content=\"#0b0f17\" media=\"(prefers-color-scheme: dark)\">\n  <meta name=\"theme-color\" content=\"#ffffff\" media=\"(prefers-color-scheme: light)\">\n  <link rel=\"icon\" href=\"data:image/svg+xml,&lt;svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'&gt;&lt;rect width='32' height='32' rx='8' fill='%230b0f17'/&gt;&lt;path d='M9 22V10h6.5a3.5 3.5 0 010 7H12v5H9zm3-7.5h3.5a1 1 0 100-2H12v2z' fill='%2310d39b'/&gt;&lt;/svg&gt;\">\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap\" rel=\"stylesheet\">\n  <script>\n    // Read theme preference BEFORE Tailwind loads to avoid a flash of the wrong theme\n    (function() {\n      var t = localStorage.getItem('paya-theme');\n      if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';\n      document.documentElement.classList.toggle('dark', t === 'dark');\n    })();\n  </script>\n  <link rel=\"stylesheet\" href=\"/tailwind.css\" integrity=\"sha384-ijhJ0fIlPjO/tmch1QanzmluLvGDlvyjC+WetNUPPTulJQkPDr0ytCFjG0PaAw5W\">\n  <style>\n    html { scroll-behavior: smooth; }\n    body { font-feature-settings: \"ss01\",\"cv11\"; -webkit-font-smoothing: antialiased; transition: background-color .2s ease, color .2s ease; }\n\n    /* Grid backdrop — subtle in light, more visible in dark */\n    .grid-bg {\n      background-image:\n        radial-gradient(circle at 50% 0%, rgba(16,211,155,.06), transparent 50%),\n        linear-gradient(rgba(11,15,23,.04) 1px, transparent 1px),\n        linear-gradient(90deg, rgba(11,15,23,.04) 1px, transparent 1px);\n      background-size: 100% 100%, 48px 48px, 48px 48px;\n    }\n    .dark .grid-bg {\n      background-image:\n        radial-gradient(circle at 50% 0%, rgba(16,211,155,.08), transparent 50%),\n        linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),\n        linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);\n    }\n\n    .text-balance { text-wrap: balance; }\n\n    /* Gradient text — works on both themes */\n    .gradient-text {\n      background: linear-gradient(135deg, #059669 0%, #10d39b 50%, #34d399 100%);\n      -webkit-background-clip: text; background-clip: text;\n      -webkit-text-fill-color: transparent;\n    }\n    .dark .gradient-text {\n      background: linear-gradient(135deg, #10d39b 0%, #34d399 50%, #6ee7b7 100%);\n      -webkit-background-clip: text; background-clip: text;\n      -webkit-text-fill-color: transparent;\n    }\n\n    /* Cards: light = white surface w/ ink border, dark = subtle white tint */\n    .card {\n      background: #ffffff;\n      border: 1px solid rgba(11,15,23,.08);\n      transition: border-color .2s ease, box-shadow .2s ease, transform .15s ease;\n    }\n    .card:hover {\n      border-color: rgba(5,150,105,.35);\n      box-shadow: 0 1px 3px rgba(11,15,23,.06), 0 8px 24px -8px rgba(5,150,105,.18);\n    }\n    .dark .card {\n      background: linear-gradient(180deg, rgba(255,255,255,.02) 0%, rgba(255,255,255,0) 100%);\n      border-color: rgba(255,255,255,.06);\n    }\n    .dark .card:hover {\n      border-color: rgba(16,211,155,.3);\n      box-shadow: none;\n    }\n\n    /* Pill (live status / \"most popular\") */\n    .pill {\n      background: rgba(5,150,105,.08);\n      border: 1px solid rgba(5,150,105,.25);\n      color: #047857;\n    }\n    .dark .pill {\n      background: rgba(16,211,155,.08);\n      border-color: rgba(16,211,155,.2);\n      color: #6ee7b7;\n    }\n\n    .num { font-variant-numeric: tabular-nums; }\n\n    code.k {\n      background: rgba(11,15,23,.04);\n      border: 1px solid rgba(11,15,23,.08);\n      border-radius: 6px;\n      padding: 1px 6px;\n      font-size: .85em;\n    }\n    .dark code.k {\n      background: rgba(255,255,255,.04);\n      border-color: rgba(255,255,255,.06);\n    }\n  </style>\n</head>\n<body class=\"font-sans bg-white text-ink-900 dark:bg-ink-950 dark:text-ink-100 antialiased\">\n\n<!-- ── NAV ───────────────────────────────────────────────────────────────── -->\n<header class=\"sticky top-0 z-40 backdrop-blur-md bg-white/80 dark:bg-ink-950/70 border-b border-ink-200 dark:border-white/5\">\n  <div class=\"max-w-6xl mx-auto px-6 h-16 flex items-center justify-between\">\n    <a href=\"/\" class=\"flex items-center gap-2 font-bold text-lg\">\n      <span class=\"inline-flex items-center justify-center w-8 h-8 rounded-lg bg-mint-500/15 text-mint-600 dark:text-mint-400 border border-mint-500/30\">P</span>\n      <span>Paya</span>\n    </a>\n    <nav class=\"hidden md:flex items-center gap-8 text-sm text-ink-600 dark:text-ink-300\">\n      <a href=\"#features\" class=\"hover:text-ink-900 dark:hover:text-white transition-colors\">Features</a>\n      <a href=\"#how\" class=\"hover:text-ink-900 dark:hover:text-white transition-colors\">How it works</a>\n      <a href=\"#pricing\" class=\"hover:text-ink-900 dark:hover:text-white transition-colors\">Pricing</a>\n      <a href=\"#devs\" class=\"hover:text-ink-900 dark:hover:text-white transition-colors\">Developers</a>\n    </nav>\n    <div class=\"flex items-center gap-2 sm:gap-3\">\n      <button id=\"theme-toggle\" type=\"button\" aria-label=\"Toggle theme\" class=\"p-2 rounded-lg text-ink-500 hover:text-ink-900 hover:bg-ink-100 dark:text-ink-400 dark:hover:text-white dark:hover:bg-white/5 transition-colors\">\n        <!-- sun (shown in dark) -->\n        <svg class=\"hidden dark:block\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41\"></path></svg>\n        <!-- moon (shown in light) -->\n        <svg class=\"dark:hidden\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z\"></path></svg>\n      </button>\n      <a href=\"/login\" class=\"hidden sm:inline text-sm text-ink-600 dark:text-ink-300 hover:text-ink-900 dark:hover:text-white\">Sign in</a>\n      <a href=\"/register\" class=\"text-sm font-medium bg-mint-600 hover:bg-mint-700 dark:bg-mint-500 dark:hover:bg-mint-400 text-white dark:text-ink-950 px-4 py-2 rounded-lg transition-colors\">Start free</a>\n    </div>\n  </div>\n</header>\n\n<!-- ── HERO ──────────────────────────────────────────────────────────────── -->\n<section class=\"grid-bg relative overflow-hidden\">\n  <div class=\"max-w-6xl mx-auto px-6 pt-20 pb-24 sm:pt-28 sm:pb-32\">\n    <div class=\"max-w-3xl\">\n      <span class=\"pill text-xs font-medium px-3 py-1 rounded-full inline-flex items-center gap-2\">\n        <span class=\"w-1.5 h-1.5 rounded-full bg-mint-500 dark:bg-mint-400 animate-pulse\"></span>\n        Live on Solana mainnet · USDC\n      </span>\n      <h1 class=\"mt-6 text-4xl sm:text-5xl lg:text-6xl font-extrabold text-balance leading-[1.05] tracking-tight\">\n        Get paid in <span class=\"gradient-text\">stablecoins</span>,<br class=\"hidden sm:block\">\n        in seconds, anywhere.\n      </h1>\n      <p class=\"mt-6 text-lg sm:text-xl text-ink-600 dark:text-ink-300 text-balance max-w-2xl leading-relaxed\">\n        Paya is the payment platform for freelancers and small businesses. Send invoices, share payment links, accept USDC, cash out to your bank — all on a real-time, low-fee rail built on Solana.\n      </p>\n      <div class=\"mt-10 flex flex-wrap items-center gap-4\">\n        <a href=\"#cta\" class=\"bg-mint-600 hover:bg-mint-700 dark:bg-mint-500 dark:hover:bg-mint-400 text-white dark:text-ink-950 px-6 py-3 rounded-lg font-semibold transition-colors\">\n          Create free account\n        </a>\n        <a href=\"#how\" class=\"text-ink-700 dark:text-ink-200 hover:text-ink-900 dark:hover:text-white border border-ink-200 dark:border-white/10 hover:border-ink-400 dark:hover:border-white/20 px-6 py-3 rounded-lg font-medium transition-colors\">\n          See how it works →\n        </a>\n      </div>\n      <div class=\"mt-12 grid grid-cols-3 gap-3 sm:gap-4 max-w-xl\">\n        <div class=\"bg-ink-50/60 dark:bg-transparent border border-ink-200/60 dark:border-transparent rounded-xl px-4 py-3 dark:p-0 dark:rounded-none dark:border-l-0\">\n          <div class=\"num text-2xl sm:text-3xl font-bold tracking-tight\">~1<span class=\"text-ink-400 dark:text-ink-500 font-medium\">s</span></div>\n          <div class=\"text-xs sm:text-sm text-ink-500 dark:text-ink-400 mt-1\">Settlement time</div>\n        </div>\n        <div class=\"bg-ink-50/60 dark:bg-transparent border border-ink-200/60 dark:border-transparent rounded-xl px-4 py-3 dark:p-0 dark:rounded-none dark:border-l-0\">\n          <div class=\"num text-2xl sm:text-3xl font-bold tracking-tight\">0.5<span class=\"text-ink-400 dark:text-ink-500 font-medium\">%</span></div>\n          <div class=\"text-xs sm:text-sm text-ink-500 dark:text-ink-400 mt-1\">Platform fee</div>\n        </div>\n        <div class=\"bg-ink-50/60 dark:bg-transparent border border-ink-200/60 dark:border-transparent rounded-xl px-4 py-3 dark:p-0 dark:rounded-none dark:border-l-0\">\n          <div class=\"num text-2xl sm:text-3xl font-bold tracking-tight\"><span class=\"text-ink-400 dark:text-ink-500 font-medium\">$</span>0.001</div>\n          <div class=\"text-xs sm:text-sm text-ink-500 dark:text-ink-400 mt-1\">Network cost / tx</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ── FEATURES ──────────────────────────────────────────────────────────── -->\n<section id=\"features\" class=\"py-20 sm:py-28\">\n  <div class=\"max-w-6xl mx-auto px-6\">\n    <div class=\"max-w-2xl\">\n      <p class=\"text-mint-600 dark:text-mint-400 text-sm font-semibold uppercase tracking-wider\">Features</p>\n      <h2 class=\"mt-3 text-3xl sm:text-4xl font-bold text-balance\">Everything you need to invoice, get paid, and reconcile.</h2>\n    </div>\n    <div class=\"mt-16 grid sm:grid-cols-2 lg:grid-cols-3 gap-4\">\n\n      <div class=\"card rounded-2xl p-6\">\n        <div class=\"w-10 h-10 rounded-lg bg-mint-500/10 text-mint-600 dark:text-mint-400 flex items-center justify-center mb-4\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 11H5a2 2 0 00-2 2v6a2 2 0 002 2h14a2 2 0 002-2v-6a2 2 0 00-2-2h-4M9 11V7a3 3 0 116 0v4M9 11h6\"></path></svg>\n        </div>\n        <h3 class=\"font-semibold text-lg\">Encrypted Solana wallets</h3>\n        <p class=\"mt-2 text-ink-600 dark:text-ink-400 text-sm leading-relaxed\">AES-256-GCM at rest. Multi-wallet support, default-wallet routing, balance refresh on demand.</p>\n      </div>\n\n      <div class=\"card rounded-2xl p-6\">\n        <div class=\"w-10 h-10 rounded-lg bg-mint-500/10 text-mint-600 dark:text-mint-400 flex items-center justify-center mb-4\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.72M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71\"></path></svg>\n        </div>\n        <h3 class=\"font-semibold text-lg\">Payment links</h3>\n        <p class=\"mt-2 text-ink-600 dark:text-ink-400 text-sm leading-relaxed\">One-tap shareable URLs. Fixed or open amount, expiry, metadata, instant USDC delivery.</p>\n      </div>\n\n      <div class=\"card rounded-2xl p-6\">\n        <div class=\"w-10 h-10 rounded-lg bg-mint-500/10 text-mint-600 dark:text-mint-400 flex items-center justify-center mb-4\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\"></path><path d=\"M14 2v6h6M16 13H8M16 17H8M10 9H8\"></path></svg>\n        </div>\n        <h3 class=\"font-semibold text-lg\">Invoices &amp; recurring billing</h3>\n        <p class=\"mt-2 text-ink-600 dark:text-ink-400 text-sm leading-relaxed\">Create, share, track. Auto-reminders. Recurring schedules for retainer clients.</p>\n      </div>\n\n      <div class=\"card rounded-2xl p-6\">\n        <div class=\"w-10 h-10 rounded-lg bg-mint-500/10 text-mint-600 dark:text-mint-400 flex items-center justify-center mb-4\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M22 11.08V12a10 10 0 11-5.93-9.14\"></path><path d=\"M22 4L12 14.01l-3-3\"></path></svg>\n        </div>\n        <h3 class=\"font-semibold text-lg\">Pre-flight safety</h3>\n        <p class=\"mt-2 text-ink-600 dark:text-ink-400 text-sm leading-relaxed\">Every payment is simulated and risk-scored via TxShield before submission. Sandwich, rug, and slippage protection built in.</p>\n      </div>\n\n      <div class=\"card rounded-2xl p-6\">\n        <div class=\"w-10 h-10 rounded-lg bg-mint-500/10 text-mint-600 dark:text-mint-400 flex items-center justify-center mb-4\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"23\"></line><path d=\"M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6\"></path></svg>\n        </div>\n        <h3 class=\"font-semibold text-lg\">Cash out to your bank</h3>\n        <p class=\"mt-2 text-ink-600 dark:text-ink-400 text-sm leading-relaxed\">Convert USDC to EUR, USD, or local currency through partnered providers. Same-day in supported regions.</p>\n      </div>\n\n      <div class=\"card rounded-2xl p-6\">\n        <div class=\"w-10 h-10 rounded-lg bg-mint-500/10 text-mint-600 dark:text-mint-400 flex items-center justify-center mb-4\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 3h18v18H3z\"></path><path d=\"M9 9h6v6H9z\"></path></svg>\n        </div>\n        <h3 class=\"font-semibold text-lg\">Double-entry ledger</h3>\n        <p class=\"mt-2 text-ink-600 dark:text-ink-400 text-sm leading-relaxed\">Append-only audit trail. Export CSV for your accountant. Every cent reconciled to chain.</p>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<!-- ── HOW IT WORKS ──────────────────────────────────────────────────────── -->\n<section id=\"how\" class=\"py-20 sm:py-28 bg-ink-50 dark:bg-ink-900/40 border-y border-ink-200 dark:border-white/5\">\n  <div class=\"max-w-6xl mx-auto px-6\">\n    <div class=\"max-w-2xl\">\n      <p class=\"text-mint-600 dark:text-mint-400 text-sm font-semibold uppercase tracking-wider\">How it works</p>\n      <h2 class=\"mt-3 text-3xl sm:text-4xl font-bold text-balance\">From zero to paid in three steps.</h2>\n    </div>\n\n    <div class=\"mt-16 grid md:grid-cols-3 gap-6\">\n      <div class=\"card rounded-2xl p-8\">\n        <div class=\"num text-mint-600 dark:text-mint-400 font-mono text-sm font-medium\">01</div>\n        <h3 class=\"mt-4 font-semibold text-xl\">Create your account</h3>\n        <p class=\"mt-3 text-ink-600 dark:text-ink-400 text-sm leading-relaxed\">Sign up with email. We provision an encrypted Solana wallet for you. No seed phrase to lose, no chain knowledge required.</p>\n      </div>\n      <div class=\"card rounded-2xl p-8\">\n        <div class=\"num text-mint-600 dark:text-mint-400 font-mono text-sm font-medium\">02</div>\n        <h3 class=\"mt-4 font-semibold text-xl\">Share an invoice or link</h3>\n        <p class=\"mt-3 text-ink-600 dark:text-ink-400 text-sm leading-relaxed\">Send a Paya invoice to your client or post a payment link on your portfolio. They pay with any USDC wallet — Phantom, Solflare, exchange, anywhere.</p>\n      </div>\n      <div class=\"card rounded-2xl p-8\">\n        <div class=\"num text-mint-600 dark:text-mint-400 font-mono text-sm font-medium\">03</div>\n        <h3 class=\"mt-4 font-semibold text-xl\">Get paid. Cash out.</h3>\n        <p class=\"mt-3 text-ink-600 dark:text-ink-400 text-sm leading-relaxed\">USDC lands in your wallet in about a second. Hold it as savings, send to another wallet, or cash out to your bank.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ── MOBILE APP ────────────────────────────────────────────────────────── -->\n<section id=\"download\" class=\"py-20 sm:py-28\">\n  <div class=\"max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center\">\n    <div>\n      <p class=\"text-mint-600 dark:text-mint-400 text-sm font-semibold uppercase tracking-wider\">Mobile</p>\n      <h2 class=\"mt-3 text-3xl sm:text-4xl font-bold text-balance\">Run your business from your phone.</h2>\n      <p class=\"mt-6 text-lg text-ink-600 dark:text-ink-300 leading-relaxed\">QR receive, contact-based send, biometric login, push notifications when you get paid. Available for Android — iOS coming soon.</p>\n      <div class=\"mt-8 flex flex-wrap gap-4\">\n        <a href=\"/dl/paya-mobile.apk\" class=\"bg-ink-100 hover:bg-ink-200 dark:bg-white/5 dark:hover:bg-white/10 border border-ink-200 dark:border-white/10 hover:border-ink-300 dark:hover:border-white/20 px-5 py-3 rounded-lg font-medium transition-colors inline-flex items-center gap-3\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.213-3.207l2.852 1.652a1 1 0 010 1.732l-2.853 1.653-2.581-2.585 2.582-2.452zM5.864 2.658L16.802 8.99l-2.303 2.303L5.864 2.658z\"></path></svg>\n          <span><span class=\"text-xs text-ink-500 dark:text-ink-400 block leading-none\">Download</span><span class=\"font-semibold\">Android APK</span></span>\n        </a>\n        <span class=\"bg-ink-50 dark:bg-white/[.02] border border-ink-100 dark:border-white/5 px-5 py-3 rounded-lg font-medium text-ink-400 dark:text-ink-500 inline-flex items-center gap-3 cursor-not-allowed\">\n          <svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z\"></path></svg>\n          <span><span class=\"text-xs block leading-none\">Coming soon</span><span class=\"font-semibold\">iOS</span></span>\n        </span>\n      </div>\n    </div>\n    <div class=\"relative\">\n      <div class=\"aspect-[9/19] bg-gradient-to-br from-ink-100 to-ink-50 dark:from-ink-800 dark:to-ink-900 rounded-[2.5rem] border border-ink-200 dark:border-white/10 p-2 max-w-[280px] mx-auto shadow-glow\">\n        <div class=\"bg-white dark:bg-ink-950 rounded-[2.2rem] h-full p-6 flex flex-col\">\n          <div class=\"flex items-center justify-between text-xs text-ink-500 dark:text-ink-400 mb-8\">\n            <span class=\"num\">9:41</span>\n            <span class=\"flex gap-1\"><span class=\"w-1 h-1 rounded-full bg-ink-400 dark:bg-ink-400\"></span><span class=\"w-1 h-1 rounded-full bg-ink-400 dark:bg-ink-400\"></span></span>\n          </div>\n          <p class=\"text-ink-500 dark:text-ink-400 text-xs uppercase tracking-wider\">Balance</p>\n          <p class=\"num font-bold text-3xl mt-1\">$2,847.<span class=\"text-ink-400 dark:text-ink-400\">23</span> <span class=\"text-ink-400 dark:text-ink-500 text-base font-medium\">USDC</span></p>\n          <div class=\"mt-6 grid grid-cols-3 gap-2 text-center text-xs\">\n            <div class=\"bg-ink-50 dark:bg-white/5 rounded-xl py-3 border border-ink-100 dark:border-white/5\"><div class=\"text-mint-600 dark:text-mint-400 text-lg\">↗</div>Send</div>\n            <div class=\"bg-ink-50 dark:bg-white/5 rounded-xl py-3 border border-ink-100 dark:border-white/5\"><div class=\"text-mint-600 dark:text-mint-400 text-lg\">↙</div>Receive</div>\n            <div class=\"bg-ink-50 dark:bg-white/5 rounded-xl py-3 border border-ink-100 dark:border-white/5\"><div class=\"text-mint-600 dark:text-mint-400 text-lg\">⬇</div>Cash out</div>\n          </div>\n          <div class=\"mt-6 flex-1 space-y-3\">\n            <div class=\"flex items-center justify-between text-xs\">\n              <div><div class=\"font-medium\">Acme Co.</div><div class=\"text-ink-500 dark:text-ink-500\">Invoice #1042</div></div>\n              <div class=\"text-mint-600 dark:text-mint-400 num\">+$1,200.00</div>\n            </div>\n            <div class=\"flex items-center justify-between text-xs\">\n              <div><div class=\"font-medium\">paya.fund/pay/...</div><div class=\"text-ink-500 dark:text-ink-500\">Link payment</div></div>\n              <div class=\"text-mint-600 dark:text-mint-400 num\">+$50.00</div>\n            </div>\n            <div class=\"flex items-center