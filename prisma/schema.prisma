generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUM TYPES
// ============================================================

enum AccountRole {
  admin
  viewer
  buyer
  seller
  auditor
}

enum TenantStatus {
  active
  suspended
  trial
  churned
}

enum BusinessStatus {
  active
  suspended
  pending
  deactivated
}

enum EscrowStatus {
  created
  funded
  in_escrow
  completed
  cancelled
  disputed
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
  cancelled
}

enum WalletStatus {
  active
  frozen
  closed
}

enum TransactionType {
  credit
  debit
}

enum KycStatus {
  not_started
  in_progress
  verified
  rejected
  expired
}

enum FraudSeverity {
  low
  medium
  high
  critical
}

enum ComplianceStatus {
  pending
  clear
  suspicious
  blocked
}

// ============================================================
// MODULE 0: MULTI-TENANCY — Tenant & Account
// ============================================================

model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique // used in subdomain/URL: youngsend.space-z.ai
  plan          String   @default("starter") // starter, professional, enterprise
  status        TenantStatus @default(active)
  maxBusinesses Int      @default(5)
  maxUsers      Int      @default(10)
  features      String   @default("{}") // JSON: feature flags
  ownerEmail    String
  ownerName     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  businesses      Business[]
  accounts        Account[]
  users           User[]
  complianceRules ComplianceRule[]

  @@index([slug])
  @@index([status])
}

model Account {
  id           String    @id @default(cuid())
  email        String
  passwordHash String
  name         String
  role         AccountRole    @default(admin)
  tenantId     String
  businessId   String? // which business this user primarily operates as
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant               Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referralCode         String? @unique
  referredBy           String? // Intentionally a loose reference (not FK) to avoid cascade issues with self-referencing
  notificationsEnabled Boolean @default(true)
  twoFactorEnabled     Boolean @default(false)

  referralBonusesAsReferrer ReferralBonus[] @relation("ReferralReferrer")
  referralBonusesAsReferee  ReferralBonus[] @relation("ReferralReferee")
  notifications             Notification[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([role])
  @@index([isActive])
}

// ============================================================
// MODULE 1: COMMERCE PASSPORT — Business Identity & Verification
// ============================================================

model Business {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  legalName      String?
  registrationNo String?
  taxId          String?
  country        String
  city           String?
  industry       String?
  website        String?
  employeeCount  Int?
  annualRevenue  Float?
  description    String?
  logoUrl        String?
  status         BusinessStatus    @default(pending)
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  tenant                      Tenant                     @relation(fields: [tenantId], references: [id])
  passport                    CommercePassport?
  trustScore                  TrustScore?
  digitalTwin                 FinancialDigitalTwin?
  sentRelationships           BusinessRelationship[]       @relation("SentRelationships")
  receivedRelationships       BusinessRelationship[]       @relation("ReceivedRelationships")
  escrowAsBuyer               EscrowTransaction[]          @relation("Buyer")
  escrowAsSeller              EscrowTransaction[]          @relation("Seller")
  sentInvoices                Invoice[]                    @relation("InvoiceSender")
  receivedInvoices            Invoice[]                    @relation("InvoiceReceiver")
  verifications               Verification[]
  wallets                     Wallet[]
  reviewsFrom                 Review[]                     @relation("ReviewFrom")
  reviewsTo                   Review[]                     @relation("ReviewTo")
  paymentMethods              PaymentMethod[]
  paymentLinks                PaymentLink[]
  users                       User[]
  fraudAlerts                 FraudAlert[]
  collectionCasesAsCreditor   CollectionCase[]             @relation("CollectionCreditor")
  collectionCasesAsDebtor     CollectionCase[]             @relation("CollectionDebtor")
  subscriptions               Subscription[]
  matchesAsSeeker             BusinessMatch[]              @relation("MatchSeeker")
  matchesAsCandidate          BusinessMatch[]              @relation("MatchCandidate")
  complianceScreenings        ComplianceScreening[]

  @@index([tenantId])
  @@index([country])
  @@index([industry])
  @@index([status])
}

model CommercePassport {
  id              String    @id @default(cuid())
  businessId      String    @unique
  passportHash    String    @unique
  credentialLevel String    @default("basic") // basic, standard, enhanced, premium
  kycStatus       KycStatus    @default(not_started)
  kycVerifiedAt   DateTime?
  amlStatus       String    @default("not_started") // not_started, cleared, flagged, rejected
  amlCheckedAt    DateTime?
  riskRating      String    @default("medium") // low, medium, high, critical
  lastAuditAt     DateTime?
  nextAuditDue    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business       Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  complianceDocs ComplianceDocument[]

  @@index([credentialLevel])
  @@index([riskRating])
}

model Verification {
  id              String    @id @default(cuid())
  businessId      String
  type            String // identity, business_registration, tax, bank_account, address
  method          String // document, api, manual, third_party
  status          String    @default("pending") // pending, in_progress, approved, rejected, expired
  submittedAt     DateTime  @default(now())
  verifiedAt      DateTime?
  verifiedBy      String?
  rejectionReason String?
  metadata        String? // JSON string for extra data
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([type])
  @@index([status])
}

model ComplianceDocument {
  id         String    @id @default(cuid())
  passportId String
  docType    String // certificate_of_incorporation, tax_registration, bank_statement, proof_of_address, license
  docName    String
  docUrl     String?
  status     String    @default("pending") // pending, approved, rejected, expired
  uploadedAt DateTime  @default(now())
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  passport CommercePassport @relation(fields: [passportId], references: [id], onDelete: Cascade)

  @@index([passportId])
  @@index([docType])
  @@index([status])
}

// ============================================================
// MODULE 2: TRUST GRAPH — Reputation & Relationship Network
// ============================================================

model TrustScore {
  id                 String   @id @default(cuid())
  businessId         String   @unique
  overallScore       Float    @default(50.0)
  paymentScore       Float    @default(50.0)
  deliveryScore      Float    @default(50.0)
  qualityScore       Float    @default(50.0)
  communicationScore Float    @default(50.0)
  complianceScore    Float    @default(50.0)
  totalReviews       Int      @default(0)
  totalTransactions  Int      @default(0)
  scoreVersion       Int      @default(1)
  lastCalculated     DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reputationEvents ReputationEvent[]

  @@index([overallScore])
}

model BusinessRelationship {
  id             String    @id @default(cuid())
  fromBusinessId String
  toBusinessId   String
  type           String // supplier, buyer, partner, logistics, financial
  status         String    @default("active") // active, paused, terminated
  trustLevel     Float     @default(50.0)
  totalTxVolume  Float     @default(0)
  totalTxCount   Int       @default(0)
  firstTxDate    DateTime?
  lastTxDate     DateTime?
  metadata       String? // JSON string
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  fromBusiness Business @relation("SentRelationships", fields: [fromBusinessId], references: [id], onDelete: Cascade)
  toBusiness   Business @relation("ReceivedRelationships", fields: [toBusinessId], references: [id], onDelete: Cascade)

  @@unique([fromBusinessId, toBusinessId, type])
  @@index([fromBusinessId])
  @@index([toBusinessId])
  @@index([type])
  @@index([trustLevel])
}

model ReputationEvent {
  id           String   @id @default(cuid())
  trustScoreId String
  eventType    String // transaction_completed, review_received, dispute_resolved, verification_upgraded, penalty_applied
  scoreImpact  Float    @default(0)
  description  String?
  sourceId     String? // ID of related entity (escrow_id, review_id, etc.)
  metadata     String? // JSON string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  trustScore TrustScore @relation(fields: [trustScoreId], references: [id], onDelete: Cascade)

  @@index([trustScoreId])
  @@index([eventType])
  @@index([createdAt])
}

model Review {
  id                  String    @id @default(cuid())
  fromBusinessId      String
  toBusinessId        String
  escrowId            String?
  rating              Float // 1-5
  paymentRating       Float?
  deliveryRating      Float?
  qualityRating       Float?
  communicationRating Float?
  comment             String?
  response            String?
  respondedAt         DateTime?
  status              String    @default("published") // published, hidden, flagged
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  fromBusiness Business @relation("ReviewFrom", fields: [fromBusinessId], references: [id], onDelete: Cascade)
  toBusiness   Business @relation("ReviewTo", fields: [toBusinessId], references: [id], onDelete: Cascade)

  @@index([fromBusinessId])
  @@index([toBusinessId])
  @@index([rating])
  @@index([createdAt])
}

// ============================================================
// MODULE 3: AI SMART ESCROW — Transaction State Machine
// ============================================================

model EscrowTransaction {
  id               String         @id @default(cuid())
  txRef            String         @unique
  buyerId          String
  sellerId         String
  amount           Float
  currency         String         @default("USD")
  description      String?
  status           EscrowStatus         @default(created)
  currentMilestone Int            @default(0)
  totalMilestones  Int            @default(1)
  fundedAmount     Float          @default(0)
  releasedAmount   Float          @default(0)
  refundedAmount   Float          @default(0)
  feeAmount        Float          @default(0)
  feeCurrency      String         @default("USD")
  aiRiskScore      Float?
  aiRiskLevel      String? // low, medium, high
  paymentIntentId  String?
  paymentIntent    PaymentIntent?
  expiresAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  buyer          Business          @relation("Buyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller         Business          @relation("Seller", fields: [sellerId], references: [id], onDelete: Restrict)
  milestones     EscrowMilestone[]
  disbursements  Disbursement[]
  disputes       Dispute[]
  auditLog       EscrowAuditLog[]
  buyerWalletId  String?
  sellerWalletId String?
  releasedAt     DateTime?

  @@index([status])
  @@index([buyerId])
  @@index([sellerId])
  @@index([currency])
  @@index([createdAt])
  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
}

model EscrowMilestone {
  id          String    @id @default(cuid())
  escrowId    String
  sequence    Int
  title       String
  description String?
  amount      Float
  status      String    @default("pending") // pending, ready, released, disputed
  evidence    String? // JSON array of evidence URLs
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  escrow EscrowTransaction @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@unique([escrowId, sequence])
  @@index([escrowId])
  @@index([status])
}

model Disbursement {
  id          String    @id @default(cuid())
  escrowId    String
  milestoneId String?
  amount      Float
  currency    String
  fromAccount String?
  toAccount   String?
  status      PaymentStatus    @default(pending) // pending, processing, completed, failed
  paymentRef  String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  escrow EscrowTransaction @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@index([escrowId])
  @@index([status])
}

model Dispute {
  id               String    @id @default(cuid())
  escrowId         String
  raisedBy         String // buyer or seller
  reason           String
  description      String?
  status           String    @default("open") // open, under_review, resolved, escalated
  resolution       String?
  resolvedAt       DateTime?
  aiRecommendation String?
  metadata         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  escrow EscrowTransaction @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@index([escrowId])
  @@index([status])
  @@index([escrowId, status])
}

model EscrowAuditLog {
  id        String   @id @default(cuid())
  escrowId  String
  action    String
  actor     String?
  details   String?
  metadata  String?
  createdAt DateTime @default(now())

  escrow EscrowTransaction @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@index([escrowId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// MODULE 4: GLOBAL PAYMENT ROUTER — Multi-Currency & Routing
// ============================================================

model PaymentIntent {
  id              String    @id @default(cuid())
  intentRef       String    @unique
  escrowId        String?   @unique
  fromBusinessId  String
  toBusinessId    String
  sourceAmount    Float
  sourceCurrency  String
  targetAmount    Float
  targetCurrency  String
  exchangeRate    Float?
  status          String    @default("created") // created, processing, completed, failed, cancelled
  paymentMethod   String? // bank_transfer, card, crypto, mobile_money, digital_wallet
  routingProvider String? // stripe, wise, paypal, local_bank, crypto_network
  routingScore    Float? // AI-calculated routing optimization score
  estimatedFee    Float?
  actualFee       Float?
  estimatedTime   Int? // in minutes
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  escrow       EscrowTransaction?   @relation(fields: [escrowId], references: [id])
  transactions PaymentTransaction[]

  @@index([status])
  @@index([fromBusinessId])
  @@index([toBusinessId])
  @@index([paymentMethod])
  @@index([createdAt])
  @@index([fromBusinessId, status])
  @@index([toBusinessId, status])
  @@index([fromBusinessId, createdAt])
  @@index([toBusinessId, createdAt])
}

model PaymentTransaction {
  id           String    @id @default(cuid())
  intentId     String
  txRef        String    @unique
  provider     String
  providerTxId String?
  amount       Float
  currency     String
  status       String    @default("pending") // pending, processing, settled, failed, refunded
  fromAddress  String?
  toAddress    String?
  metadata     String?
  settledAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  intent PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([intentId])
  @@index([status])
  @@index([provider])
  @@index([createdAt])
}

model CurrencyRate {
  id           String   @id @default(cuid())
  fromCurrency String
  toCurrency   String
  rate         Float
  provider     String
  source       String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([fromCurrency, toCurrency, provider, createdAt])
  @@index([fromCurrency, toCurrency])
}

model PaymentMethod {
  id         String   @id @default(cuid())
  businessId String
  type       String // bank_account, card, crypto_wallet, mobile_money, digital_wallet
  provider   String? // stripe, paypal, wise, etc.
  label      String?
  identifier String? // masked account/card number
  currency   String?
  country    String?
  isDefault  Boolean  @default(false)
  status     String   @default("active") // active, inactive, verification_required
  metadata   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([type])
  @@index([status])
}

// ============================================================
// MODULE 5: FINANCIAL DIGITAL TWIN — AI-Powered Financial Profile
// ============================================================

model FinancialDigitalTwin {
  id               String   @id @default(cuid())
  businessId       String   @unique
  healthScore      Float    @default(50.0)
  cashFlowHealth   Float    @default(50.0)
  riskAppetite     String   @default("moderate") // conservative, moderate, aggressive
  creditWorthiness Float    @default(50.0)
  liquidityScore   Float    @default(50.0)
  growthTrajectory String   @default("stable") // declining, stable, growing, rapid_growth
  aiModelVersion   String   @default("v1.0")
  lastSyncAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business    Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  metrics     FinancialMetric[]
  predictions FinancialPrediction[]
  snapshots   FinancialSnapshot[]

  @@index([healthScore])
  @@index([growthTrajectory])
}

model FinancialMetric {
  id                      String   @id @default(cuid())
  twinId                  String
  period                  String // daily, weekly, monthly, quarterly, yearly
  periodDate              String // ISO date for the period
  revenue                 Float?
  expenses                Float?
  netIncome               Float?
  accountsReceivable      Float?
  accountsPayable         Float?
  totalAssets             Float?
  totalLiabilities        Float?
  cashBalance             Float?
  transactionCount        Int?
  averageTransactionValue Float?
  paymentSuccessRate      Float?
  disputeRate             Float?
  customerCount           Int?
  supplierCount           Int?
  createdAt               DateTime @default(now())

  twin FinancialDigitalTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)

  @@unique([twinId, period, periodDate])
  @@index([twinId])
  @@index([period])
}

model FinancialPrediction {
  id             String   @id @default(cuid())
  twinId         String
  predictionType String // revenue, cash_flow, risk, default_probability, growth_rate
  timeframe      String // 30d, 60d, 90d, 6m, 1y
  predictedValue Float
  confidence     Float // 0-1
  lowerBound     Float?
  upperBound     Float?
  model          String   @default("ensemble")
  metadata       String?
  createdAt      DateTime @default(now())

  twin FinancialDigitalTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)

  @@index([twinId])
  @@index([predictionType])
}

model FinancialSnapshot {
  id               String   @id @default(cuid())
  twinId           String
  snapshotType     String // daily, weekly, event_driven
  healthScore      Float
  cashFlowHealth   Float
  creditWorthiness Float
  liquidityScore   Float
  topRiskFactors   String? // JSON array
  topOpportunities String? // JSON array
  aiSummary        String?
  metadata         String?
  createdAt        DateTime @default(now())

  twin FinancialDigitalTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)

  @@index([twinId])
  @@index([snapshotType])
  @@index([createdAt])
}

// ============================================================
// SHARED: Invoice Module
// ============================================================

model Invoice {
  id         String    @id @default(cuid())
  invoiceRef String    @unique
  senderId   String
  receiverId String
  escrowId   String?
  amount     Float
  currency   String    @default("USD")
  status     String    @default("draft") // draft, sent, paid, partially_paid, overdue, cancelled
  dueDate    DateTime?
  paidAmount Float     @default(0)
  items      String? // JSON array of line items
  notes      String?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sender         Business @relation("InvoiceSender", fields: [senderId], references: [id], onDelete: Restrict)
  receiver       Business @relation("InvoiceReceiver", fields: [receiverId], references: [id], onDelete: Restrict)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@index([dueDate])
  @@index([senderId, createdAt])
  @@index([senderId, status])
  @@index([receiverId, status])
}

// ============================================================
// MODULE 6: USERS & ROLES — Multi-view Access Control
// ============================================================

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  role        AccountRole    @default(viewer)
  businessId  String? // which business this user belongs to
  tenantId    String? // which tenant this user belongs to
  avatarUrl   String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  business Business? @relation(fields: [businessId], references: [id])

  @@index([role])
  @@index([businessId])
  @@index([tenantId])
  @@index([isActive])
}

// ============================================================
// MODULE 7: PAYMENT LINKS — Shareable Payment URLs
// ============================================================

model PaymentLink {
  id               String    @id @default(cuid())
  linkRef          String    @unique
  businessId       String
  title            String?
  description      String?
  amount           Float // 0 = open amount (payer decides)
  currency         String    @default("USD")
  allowedMethods   String    @default("[]") // JSON array of allowed payment method types
  allowedCountries String? // JSON array of country codes, null = all
  maxPayments      Int       @default(1) // 0 = unlimited
  paymentCount     Int       @default(0)
  totalCollected   Float     @default(0)
  status           String    @default("active") // active, paused, expired, depleted
  expiresAt        DateTime?
  metadata         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments  PaymentLinkPayment[]
  createdBy String?

  @@index([businessId])
  @@index([status])
  @@index([currency])
  @@index([createdAt])
  @@index([businessId, createdAt])
}

model PaymentLinkPayment {
  id            String    @id @default(cuid())
  paymentLinkId String
  payerName     String?
  payerEmail    String?
  payerCountry  String?
  amount        Float
  currency      String
  paymentMethod String // bank_transfer, card, mobile_money, digital_wallet, crypto, upi, pix, mpesa, etc.
  provider      String?
  status        PaymentStatus    @default(pending) // pending, processing, completed, failed, refunded
  feeAmount     Float?
  netAmount     Float?
  providerTxId  String?
  metadata      String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  paymentLink PaymentLink @relation(fields: [paymentLinkId], references: [id], onDelete: Cascade)

  @@index([paymentLinkId])
  @@index([status])
  @@index([payerCountry])
  @@index([paymentMethod])
  @@index([createdAt])
}

// ============================================================
// MODULE 8: GLOBAL PAYMENT METHODS CATALOG
// ============================================================

model GlobalPaymentMethod {
  id             String   @id @default(cuid())
  methodCode     String // mpesa, upi, pix, alipay, wechat_pay, gcash, grabpay, ovo, dana, bca, promptpay, fps, sepa, ach, swift, etc.
  methodName     String // M-Pesa, UPI, PIX, Alipay, etc.
  provider       String // safaricom, npci, bcb, ant_group, tencent, gcash, grab, etc.
  type           String // mobile_money, digital_wallet, bank_transfer, card, crypto, real_time_payment
  countries      String // JSON array of ISO country codes where available
  currencies     String // JSON array of supported currency codes
  minAmount      Float?
  maxAmount      Float?
  feePercent     Float    @default(0) // percentage fee
  fixedFee       Float    @default(0) // fixed fee per transaction
  settlementTime Int? // settlement time in minutes
  isActive       Boolean  @default(true)
  icon           String? // emoji or icon name
  metadata       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([methodCode])
  @@index([type])
  @@index([isActive])
}

// ============================================================// MODULE 9: MULTI-CURRENCY WALLET// ============================================================

model Wallet {
  id               String   @id @default(cuid())
  businessId       String
  currency         String
  balance          Float    @default(0)
  availableBalance Float    @default(0)
  pendingBalance   Float    @default(0)
  frozenBalance    Float    @default(0)
  isDefault        Boolean  @default(false)
  status           WalletStatus   @default(active)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business          Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  transactions      WalletTransaction[]
  deposits          Deposit[]
  withdrawals       Withdrawal[]
  cryptoWithdrawals CryptoWithdrawal[]
  conversionsOut    CurrencyConversion[] @relation("ConversionFrom")
  conversionsIn     CurrencyConversion[] @relation("ConversionTo")

  label String?

  @@unique([businessId, currency])
  @@index([businessId])
  @@index([currency])
  @@index([status])
  @@index([businessId, status])
}

model WalletTransaction {
  id             String   @id @default(cuid())
  walletId       String
  txRef          String   @unique
  type           String // credit, debit, transfer_in, transfer_out, conversion, fee, refund, deposit, withdrawal, crypto_withdrawal
  amount         Float
  balanceBefore  Float
  balanceAfter   Float
  currency       String
  description    String?
  referenceType  String? // escrow, payment_link, invoice, transfer, conversion, deposit, withdrawal, crypto_withdrawal
  referenceId    String?
  counterpartyId String? // other wallet/business involved
  status         String   @default("completed") // pending, completed, failed, reversed
  metadata       String?
  createdAt      DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([referenceType])
  @@index([status])
  @@index([createdAt])
  @@index([walletId, createdAt])
  @@index([walletId, type])
  @@index([walletId, status])
  @@index([referenceType, referenceId])
}

// ── Immutable Double-Entry Ledger ──────────────────────────────

model LedgerEntry {
  id            String    @id @default(cuid())
  entryRef      String    @unique
  correlationId String    // groups related entries (e.g. a payment + fee)
  causationId   String?   // what caused this entry (e.g. the payment intent ID)
  accountType   String    // wallet, escrow_hold, escrow_liability, platform_revenue, platform_fee, settlement
  accountId     String    // the wallet/business ID this entry belongs to
  entryType     String    // debit, credit
  amount        Float
  currency      String
  balanceAfter  Float     // running balance for this account+currency
  description   String?
  metadata      String?
  status        String    @default("posted") // pending, posted, reversed
  reversalOfId  String?
  createdAt     DateTime  @default(now())

  reversalOf  LedgerEntry?  @relation("Reversal", fields: [reversalOfId], references: [id])
  reversals   LedgerEntry[] @relation("Reversal")

  @@index([correlationId])
  @@index([accountType, accountId])
  @@index([causationId])
  @@index([accountType, accountId, currency, createdAt])
  @@index([status])
}

// ── Deposit Model ─────────────────────────────────────────────

model Deposit {
  id            String    @id @default(cuid())
  depositRef    String    @unique
  walletId      String
  amount        Float
  currency      String
  paymentMethod String // bank_transfer, card, mobile_money, payment_link, external
  provider      String? // paystack, stripe, flutterwave, intasend, manual
  providerTxId  String? // external provider transaction ID
  status        String    @default("pending") // pending, processing, completed, failed, reversed
  bankName      String? // source bank name for bank transfers
  bankRef       String? // bank reference / cheque number
  cardLast4     String? // last 4 digits of card used
  notes         String?
  completedAt   DateTime?
  failedReason  String?
  metadata      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([status])
  @@index([paymentMethod])
  @@index([provider])
  @@index([createdAt])
  @@index([walletId, createdAt])
  @@index([walletId, status])
  @@index([status, createdAt])
}

// ── Withdrawal Model ──────────────────────────────────────────

model Withdrawal {
  id            String    @id @default(cuid())
  withdrawalRef String    @unique
  walletId      String
  amount        Float
  currency      String
  paymentMethod String // bank_transfer, mobile_money, external
  provider      String? // paystack, stripe, flutterwave, intasend, manual
  providerTxId  String?
  status        String    @default("pending") // pending, processing, completed, failed, reversed
  bankName      String? // destination bank name
  bankAccount   String? // destination bank account (masked)
  bankCode      String? // bank sort/routing code
  recipientName String?
  feeAmount     Float     @default(0)
  netAmount     Float?
  notes         String?
  completedAt   DateTime?
  failedReason  String?
  metadata      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([status])
  @@index([paymentMethod])
  @@index([createdAt])
  @@index([walletId, createdAt])
  @@index([walletId, status])
  @@index([status, createdAt])
}

// ── Crypto Withdrawal Model ───────────────────────────────────

model CryptoWithdrawal {
  id             String    @id @default(cuid())
  withdrawalRef  String    @unique
  walletId       String
  amount         Float // amount in wallet fiat currency to convert
  cryptoAmount   Float? // amount in crypto after conversion
  currency       String // wallet fiat currency (e.g. USD, KES)
  cryptoCurrency String // target crypto (USDT, USDC, BTC, ETH, SOL, BNB)
  network        String // trc20, erc20, bsc, solana, bitcoin, bep2
  walletAddress  String // destination crypto wallet address
  status         String    @default("pending") // pending, processing, completed, failed, reversed
  exchangeRate   Float? // fiat-to-crypto rate at time of withdrawal
  networkFee     Float     @default(0) // blockchain network fee in crypto
  processingFee  Float     @default(0) // platform processing fee in fiat
  gasPrice       String? // gwei/sats per byte at time of execution
  txHash         String? // on-chain transaction hash
  explorerUrl    String? // block explorer URL
  notes          String?
  completedAt    DateTime?
  failedReason   String?
  metadata       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([status])
  @@index([cryptoCurrency])
  @@index([network])
  @@index([createdAt])
}

// ── Currency Conversion Model ─────────────────────────────────

model CurrencyConversion {
  id            String   @id @default(cuid())
  conversionRef String   @unique
  fromWalletId  String
  toWalletId    String
  fromCurrency  String
  toCurrency    String
  fromAmount    Float
  toAmount      Float
  exchangeRate  Float
  feePercent    Float    @default(0.5) // 0.5% conversion fee
  feeAmount     Float
  netAmount     Float // toAmount - feeAmount
  provider      String   @default("internal")
  status        String   @default("completed") // pending, completed, failed, reversed
  metadata      String?
  createdAt     DateTime @default(now())

  fromWallet Wallet @relation("ConversionFrom", fields: [fromWalletId], references: [id], onDelete: Cascade)
  toWallet   Wallet @relation("ConversionTo", fields: [toWalletId], references: [id], onDelete: Cascade)

  @@index([fromWalletId])
  @@index([toWalletId])
  @@index([fromCurrency, toCurrency])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// MODULE 10: AI FRAUD DETECTION
// ============================================================

model FraudAlert {
  id             String    @id @default(cuid())
  alertRef       String    @unique
  businessId     String?
  relatedType    String // escrow, payment_intent, payment_link, wallet
  relatedId      String?
  severity       FraudSeverity    @default(medium) // low, medium, high, critical
  fraudType      String // unusual_amount, velocity_breach, geo_mismatch, sanctioned_entity, fake_identity, account_takeover, structure_pattern
  score          Float // 0-100 fraud confidence score
  description    String
  recommendation String?
  status         String    @default("open") // open, investigating, confirmed_fraud, false_positive, escalated, resolved
  resolvedBy     String?
  resolvedAt     DateTime?
  metadata       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([severity])
  @@index([fraudType])
  @@index([status])
  @@index([score])
  @@index([createdAt])
  @@index([businessId, createdAt])
  @@index([businessId, status])
}

model FraudRule {
  id              String    @id @default(cuid())
  name            String
  description     String?
  condition       String // JSON rule definition
  action          String // alert, block, require_review, flag
  severity        String    @default("medium")
  isActive        Boolean   @default(true)
  triggerCount    Int       @default(0)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
  @@index([severity])
}

// ============================================================
// MODULE 11: BUSINESS MATCHING — AI Buyer-Supplier Discovery
// ============================================================

model BusinessMatch {
  id                String   @id @default(cuid())
  seekerId          String // business looking for a match
  candidateId       String // business being matched
  matchType         String // supplier, buyer, partner, logistics, financial
  matchScore        Float // 0-100 AI compatibility score
  reasons           String? // JSON array of match reasons
  status            String   @default("suggested") // suggested, contacted, interested, declined, engaged
  seekerResponse    String?
  candidateResponse String?
  metadata          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  seeker    Business @relation("MatchSeeker", fields: [seekerId], references: [id], onDelete: Cascade)
  candidate Business @relation("MatchCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([seekerId, candidateId, matchType])
  @@index([seekerId])
  @@index([candidateId])
  @@index([matchScore])
  @@index([status])
}

// ============================================================
// MODULE 12: AI COLLECTIONS — Payment Reminders & Aging
// ============================================================

model CollectionCase {
  id                String    @id @default(cuid())
  caseRef           String    @unique
  invoiceId         String?
  businessId        String // creditor
  debtorId          String
  originalAmount    Float
  outstandingAmount Float
  currency          String
  agingBucket       String    @default("current") // current, 1-30, 31-60, 61-90, 90+
  priority          String    @default("normal") // low, normal, high, urgent
  status            String    @default("active") // active, paused, resolved, written_off, escalated
  reminderCount     Int       @default(0)
  lastReminderAt    DateTime?
  nextReminderDue   DateTime?
  aiStrategy        String? // AI-recommended collection strategy
  resolution        String?
  resolvedAt        DateTime?
  metadata          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business  Business @relation("CollectionCreditor", fields: [businessId], references: [id], onDelete: Cascade)
  debtor    Business @relation("CollectionDebtor", fields: [debtorId], references: [id])
  reminders CollectionReminder[]

  @@index([businessId])
  @@index([debtorId])
  @@index([agingBucket])
  @@index([priority])
  @@index([status])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([debtorId, status])
}

model CollectionReminder {
  id          String    @id @default(cuid())
  caseId      String
  channel     String // email, sms, whatsapp, in_app
  template    String // friendly, firm, final, legal
  status      String    @default("sent") // sent, delivered, read, failed
  sentAt      DateTime  @default(now())
  response    String?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  case CollectionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([channel])
  @@index([status])
}

// ============================================================
// MODULE 13: COMPLIANCE ENGINE — Rules & Screening
// ============================================================

model ComplianceRule {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  description    String?
  ruleType       String // sanctions_check, kyc_requirement, aml_threshold, transaction_limit, country_restriction, industry_restriction
  condition      String // JSON rule definition
  action         String // block, flag_for_review, require_additional_doc, allow
  severity       String   @default("medium") // low, medium, high, critical
  isActive       Boolean  @default(true)
  triggeredCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([ruleType])
  @@index([isActive])
  @@index([severity])
}

model ComplianceScreening {
  id              String    @id @default(cuid())
  businessId      String?
  transactionType String? // escrow, payment, wallet
  transactionId   String?
  screeningType   String // sanctions, pep, adverse_media, country_risk
  result          String // clear, match, potential_match, alert
  riskLevel       String // low, medium, high, critical
  details         String?
  matchedLists    String? // JSON array of matched sanction/list names
  status          String    @default("completed") // pending, in_progress, completed, escalated
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([screeningType])
  @@index([result])
  @@index([riskLevel])
  @@index([status])
  @@index([createdAt])
  @@index([businessId, createdAt])
}

// ============================================================
// MODULE 14: REFERRAL SYSTEM — Referral Links & Bonuses
// ============================================================

model ReferralBonus {
  id            String   @id @default(cuid())
  bonusRef      String   @unique
  referrerId    String // Account who referred
  refereeId     String // Account who was referred
  depositId     String // The deposit that triggered the bonus
  walletId      String // Wallet that received the bonus
  bonusAmount   Float    @default(100.00)
  bonusCurrency String   @default("USD")
  status        String   @default("credited") // credited, pending, revoked
  creditedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  referrer Account @relation("ReferralReferrer", fields: [referrerId], references: [id])
  referee  Account @relation("ReferralReferee", fields: [refereeId], references: [id])

  @@index([referrerId])
  @@index([refereeId])
  @@index([status])
  @@index([creditedAt])
}

// ============================================================
// MODULE 15: NOTIFICATIONS — In-App & Push Notifications
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  accountId  String
  title     String
  body      String
  type      String   @default("info") // info, success, warning, error, payment, escrow, invoice, system
  category  String   @default("general") // payment_received, payment_sent, escrow_created, escrow_funded, escrow_released, invoice_created, invoice_paid, invoice_overdue, collection_reminder, fraud_alert, compliance_alert, system_maintenance, referral_bonus
  isRead    Boolean  @default(false)
  readAt    DateTime?
  actionUrl String? // deep link to relevant page
  metadata  String? // JSON with additional context
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([type])
  @@index([category])
  @@index([isRead])
  @@index([createdAt])
  @@index([accountId, isRead])
  @@index([accountId, createdAt])
}

// ============================================================
// MODULE 16: SUBSCRIPTIONS — Recurring Billing Plans
// ============================================================

model Subscription {
  id          String   @id @default(cuid())
  businessId  String
  planName    String // starter, professional, enterprise, custom
  amount      Float
  currency    String   @default("USD")
  interval    String   @default("monthly") // daily, weekly, monthly, quarterly, yearly
  status      String   @default("active") // active, past_due, cancelled, paused, trialing
  startDate   DateTime @default(now())
  endDate     DateTime?
  trialEndsAt DateTime?
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  cancelledAt DateTime?
  cancellationReason String?
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([businessId])
  @@index([status])
  @@index([planName])
  @@index([interval])
  @@index([currentPeriodEnd])
  @@index([businessId, status])
  @@index([status, currentPeriodEnd])
}
