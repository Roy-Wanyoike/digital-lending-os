{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/*": [
        "./src/frontend/components/*"
      ],
      "@/hooks/*": [
        "./src/frontend/hooks/*"
      ],
      "@/lib/*": [
        "./src/backend/lib/*"
      ],
      "@/app/*": [
        "./src/app/*"
      ],
      "@/frontend/components/*": [
        "./src/frontend/components/*"
      ],
      "@/frontend/hooks/*": [
        "./src/frontend/hooks/*"
      ],
      "@/frontend/types/*": [
        "./src/frontend/types/*"
      ],
      "@/frontend/utils/*": [
        "./src/frontend/utils/*"
      ],
      "@/frontend/*": [
        "./src/frontend/*"
      ],
      "@/backend/lib/*": [
        "./src/backend/lib/*"
      ],
      "@/backend/services/*": [
        "./src/backend/services/*"
      ],
      "@/backend/config/*": [
        "./src/backend/config/*"
      ],
      "@/backend/middleware/*": [
        "./src/backend/middleware/*"
      ],
      "@/backend/*": [
        "./src/backend/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    "scripts",
    "infra",
    "mini-services",
    "tool-results",
    "download",
    "prisma",
    "skills",
    "agent-ctx",
    "__tests__"
  ]
}
